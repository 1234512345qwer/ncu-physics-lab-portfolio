# =========================================
# .gitignore —— 告诉 Git「这些文件不用管」
# =========================================

# ---------- 操作系统自动生成的文件 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.lnk

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Python（数据分析 / Jupyter） ----------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/

# ---------- MATLAB / Octave ----------
*.asv
*.m~
octave-workspace

# ---------- LaTeX（实验报告排版） ----------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.nav
*.snm
*.vrb

# ---------- 临时文件与备份 ----------
*.tmp
*.bak
*.swp
*.cache

# ---------- 压缩包（原始打包不要进仓库） ----------
*.zip
*.7z
